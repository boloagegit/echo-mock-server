<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- ConsumerSession checks its owning thread before every read/write of closed.
         Cross-thread calls fail before accessing state; the worker closes its own
         session in try-with-resources. Ownership and shutdown are tested explicitly. -->
    <Match>
        <Bug pattern="AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
        <Class name="com.echo.agent.RequestLogSpool$ConsumerSession"/>
        <Method name="close"/>
        <Field name="closed"/>
    </Match>

    <!-- Lombok-generated getters and builders for entities and DTOs. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~com\.echo\.entity\..*"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~com\.echo\.dto\..*"/>
    </Match>

    <!-- Spring constructor injection: singleton beans do not need defensive copies. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Method name="&lt;init&gt;"/>
        <Class name="~com\.echo\.(service|jms|protocol|config|pipeline|controller|agent)\..*"/>
    </Match>

    <!-- Spring-injected fields are incorrectly reported as uninitialized. -->
    <Match>
        <Bug pattern="UWF_UNWRITTEN_FIELD,NP_UNWRITTEN_FIELD"/>
    </Match>

    <!-- Inner classes generated by Lombok @Builder. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~.*\$.*Builder.*"/>
    </Match>

    <!-- record-like inner classes (TemplateContext, MatchDetail, etc.) carry short-lived data. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~com\.echo\.service\.ResponseTemplateService\$TemplateContext"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~com\.echo\.service\.ConditionMatcher\$MatchDetail"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="~com\.echo\.service\.ConditionMatcher\$PreparedBody"/>
    </Match>
    <!-- Rule-save results pass the newly written entity to the caller for audit logging; no copy is needed. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="com.echo.service.RuleEditService$Saved"/>
    </Match>

    <!-- The compiled-mode PreparedBody adapter exposes the parsed DOM and the caller's header map without copying; the interface requires read-only access. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="~com\.echo\.service\.ConditionMatcher\$(PreparedBody\$PreparedBodyView|PreparedRequestView)"/>
    </Match>

    <!-- BodyView returns the JSON/DOM parsing result shared within a request. Access is read-only; copying would negate the benefit of lazy parsing. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="com.echo.core.match.LazyBodyView"/>
    </Match>

    <!-- ProtocolHandlerRegistry.getAllHandlers() exposes the Spring-injected handler list for internal use only. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="com.echo.protocol.ProtocolHandlerRegistry"/>
        <Method name="getAllHandlers"/>
    </Match>

    <!-- RequestLogService intentionally exposes memoryBuffer/bufferSize for LogAgent to write to. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="com.echo.service.RequestLogService"/>
        <Method name="~get(MemoryBuffer|BufferSize)"/>
    </Match>

    <!-- catch(Exception) intentionally handles the various exceptions raised by XML/JSON parsing. -->
    <Match>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
        <Class name="com.echo.service.ResponseTemplateService"/>
    </Match>
    <Match>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
        <Class name="com.echo.service.RuleAuditService"/>
        <Method name="hasActualChanges"/>
    </Match>

    <!-- SqliteBackupService: backup path is internally generated, not user input -->
    <Match>
        <Bug pattern="SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
        <Class name="com.echo.service.SqliteBackupService"/>
        <Method name="backup"/>
    </Match>

    <!-- OpenApiImportService: switch default branch is intentional (covers all types) -->
    <Match>
        <Bug pattern="DB_DUPLICATE_BRANCHES"/>
        <Class name="com.echo.service.OpenApiImportService"/>
        <Method name="defaultForType"/>
    </Match>

    <!-- ServeEvent/SSE request data is passed synchronously within the same request; copying headers and candidate rules would add per-request allocations. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~com\.echo\.service\.ServeEvent(\$.*)?"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="com.echo.protocol.http.sse.SsePlayer$RequestContext"/>
    </Match>
    <!-- StableSelection keeps final, read-only RuleCandidates to preserve compiled handles;
         its constructor defensively copies all other candidate collections. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="com.echo.pipeline.AbstractMockPipeline$StableSelection"/>
        <Method name="candidates"/>
    </Match>
</FindBugsFilter>
